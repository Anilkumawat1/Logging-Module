<configuration>
    <appender name="PRODUCTION_RAW_JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%msg%n</pattern>
        </encoder>
    </appender>

    <appender name="PRODUCTION_JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <!-- Core fields in consistent order matching structured HTTP/BUSINESS events -->
                <timestamp>
                    <fieldName>timestamp</fieldName>
                </timestamp>
                <logLevel>
                    <fieldName>level</fieldName>
                </logLevel>
                <!-- type, service, environment, request_id from MDC — appear before logger so
                     field order matches the structured log events emitted by HttpLoggingFilter -->
                <mdc>
                    <includeMdcKeyName>type</includeMdcKeyName>
                    <includeMdcKeyName>service</includeMdcKeyName>
                    <includeMdcKeyName>environment</includeMdcKeyName>
                    <includeMdcKeyName>request_id</includeMdcKeyName>
                    <includeMdcKeyName>trace_id</includeMdcKeyName>
                    <includeMdcKeyName>span_id</includeMdcKeyName>
                    <includeMdcKeyName>user_id</includeMdcKeyName>
                    <includeMdcKeyName>role_ids</includeMdcKeyName>
                    <includeMdcKeyName>authenticated</includeMdcKeyName>
                </mdc>
                <loggerName>
                    <fieldName>logger</fieldName>
                </loggerName>
                <threadName>
                    <fieldName>thread</fieldName>
                </threadName>
                <message/>
                <stackTrace>
                    <fieldName>stack_trace</fieldName>
                </stackTrace>
            </providers>
        </encoder>
    </appender>

    <logger name="com.anil.logging.http" level="INFO" additivity="false">
        <appender-ref ref="PRODUCTION_RAW_JSON_CONSOLE"/>
    </logger>

    <logger name="com.anil.logging.structured" level="INFO" additivity="false">
        <appender-ref ref="PRODUCTION_RAW_JSON_CONSOLE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="PRODUCTION_JSON_CONSOLE"/>
    </root>
</configuration>
